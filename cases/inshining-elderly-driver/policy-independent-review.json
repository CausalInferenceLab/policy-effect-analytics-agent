    "synthetic_challenge_script": "import copy, hashlib, json, subprocess, sys, tempfile\nfrom pathlib import Path\nscript = Path('cases/inshining-elderly-driver/audit_policy.py')\nresults = []\nwith tempfile.TemporaryDirectory(prefix='policy-independent-challenge-') as temp:\n    root = Path(temp)\n    snapshot = root / 'source.txt'\n    snapshot.write_text('SEARCH INDEX EXCERPT: 공식 기록: 2018년 7월 지원 개시.\\n', encoding='utf8')\n    base = {'schema_version':1, 'checked_on':'2026-10-27', 'limitations':['independent synthetic challenge'], 'evidence':[{'id':'e', 'jurisdiction':'테스트시', 'source_url':'https://www.busan.go.kr/example', 'source_published_on':'2019-01-01', 'retrieval_mode':'search_index', 'snapshot_path':'source.txt', 'snapshot_sha256':hashlib.sha256(snapshot.read_bytes()).hexdigest(), 'quotation':'2018년 7월 지원 개시.', 'claim_type':'offer_start', 'claimed_start':'2018-07', 'date_precision':'month'}], 'classifications':[{'jurisdiction':'테스트시', 'first_offer_start':'2018-07', 'date_precision':'month', 'role_2019':'treated', 'evidence_ids':['e'], 'analysis_approved':False, 'reason':'synthetic', 'unresolved_checks':[]}]}\n    mutations = {\n      'missing_evidence': (lambda d:d['classifications'][0].update(evidence_ids=['missing']), True, 'missing_evidence'),\n      'hash_tamper': (lambda d:d['evidence'][0].update(snapshot_sha256='0'*64), True, 'snapshot_hash'),\n      'invalid_date': (lambda d:d['evidence'][0].update(claimed_start='2019-02-29',date_precision='day'), True, 'date_precision'),\n      'ordinance_only': (lambda d:d['evidence'][0].update(claim_type='ordinance_effective'), True, 'unsupported_first_offer'),\n      'retroactive_eligibility_only': (lambda d:d['evidence'][0].update(claim_type='eligibility_start'), True, 'unsupported_first_offer'),\n      '2019_as_candidate': (lambda d:(d['evidence'][0].update(claimed_start='2019-07'), d['classifications'][0].update(first_offer_start='2019-07',role_2019='candidate')), True, 'year_role'),\n      'unknown_as_candidate': (lambda d:d['classifications'][0].update(first_offer_start=None,date_precision='unknown',role_2019='candidate'), True, 'unknown_role'),\n      'unknown_as_zero': (lambda d:d['classifications'][0].update(first_offer_start=0,date_precision='unknown',role_2019='hold'), True, 'date_precision'),\n      'candidate_analysis_approved': (lambda d:d['classifications'][0].update(analysis_approved=True), True, 'analysis_approval'),\n      'search_index_disguised_as_direct': (lambda d:d['evidence'][0].update(retrieval_mode='direct'), True, 'retrieval_marker_mismatch'),\n      'known_date_hold_with_reasons': (lambda d:(d['evidence'][0].update(claimed_start='2020',date_precision='year'),d['classifications'][0].update(first_offer_start='2020',date_precision='year',role_2019='hold',reason='2019년 예고 미확인',unresolved_checks=['예고일'])), False, None),\n      'known_date_hold_without_unresolved_checks': (lambda d:d['classifications'][0].update(role_2019='hold'), True, 'hold_without_unresolved_checks'),\n      'known_date_hold_without_offer_evidence': (lambda d:(d['evidence'][0].update(claim_type='ordinance_effective'),d['classifications'][0].update(role_2019='hold',unresolved_checks=['예고일'])), True, 'unsupported_first_offer'),\n    }\n    for name,(mutate,reject,expected) in mutations.items():\n        document=copy.deepcopy(base);mutate(document)\n        inp=root/'input.json';out=root/'output.json';inp.write_text(json.dumps(document,ensure_ascii=False),encoding='utf8')\n        p=subprocess.run([sys.executable,str(script),'--input',str(inp),'--output',str(out)],capture_output=True,text=True)\n        report=json.loads(out.read_text());codes=[e['code'] for e in report['errors']]\n        ok=((p.returncode!=0)==reject and (expected is None or expected in codes) and report['analysis_approved'] is False)\n        results.append({'challenge':name,'expected_reject':reject,'expected_error_code':expected,'returncode':p.returncode,'status':report['status'],'errors':codes,'warnings':[e['code